{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Fake Engineering",
          "version": "1.0",
          "rules": [
            {
              "id": "compile/error"
            },
            {
              "id": "compile/warning"
            }
          ]
        }
      },
      "automationDetails": {
        "id": "linie-1/plc/compile/"
      },
      "results": [
        {
          "ruleId": "compile/error",
          "level": "error",
          "message": {
            "text": "Operand „#Freigabe“ ist nicht definiert."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "PLC_1/Programmbausteine/Foerderband/FB_Foerderband"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "compile/error",
          "level": "error",
          "message": {
            "text": "Typkonflikt: INT kann nicht nach BOOL konvertiert werden."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "PLC_1/Programmbausteine/Foerderband/FB_Foerderband"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "compile/error",
          "level": "error",
          "message": {
            "text": "Ungültiger Aufruf von „TON“: Parameter „PT“ fehlt."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "PLC_1/Programmbausteine/Greifer/FB_Greifer"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "compile/warning",
          "level": "warning",
          "message": {
            "text": "Variable „#tmpZaehler“ wird nicht verwendet."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "PLC_1/Programmbausteine/Main"
                }
              ]
            }
          ]
        }
      ],
      "properties": {
        "plcBuild": {
          "project": "linie-1/plc",
          "step": "compile",
          "adapter": "fake",
          "outcome": "failed",
          "generator": "plc-build 0.0.0-test"
        }
      }
    }
  ]
}
