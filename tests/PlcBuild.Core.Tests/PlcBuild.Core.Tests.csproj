<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PlcBuild.Core/PlcBuild.Core.csproj" />
    <ProjectReference Include="../../src/PlcBuild.Cli/PlcBuild.Cli.csproj" />
    <ProjectReference Include="../../adapters/fake/PlcBuild.Adapters.Fake.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FakeAdapterDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../adapters/fake/bin/$(Configuration)/net10.0/</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
