<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>plc-build</AssemblyName>
    <RootNamespace>PlcBuild.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PlcBuild.Core/PlcBuild.Core.csproj" />
    <!-- Build order only: the fake adapter is copied to adapters/fake next to plc-build. -->
    <ProjectReference Include="../../adapters/fake/PlcBuild.Adapters.Fake.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PlcBuild.Core.Tests" />
  </ItemGroup>

  <Target Name="CopyFakeAdapter" AfterTargets="Build">
    <ItemGroup>
      <FakeAdapterFiles Include="$(MSBuildThisFileDirectory)../../adapters/fake/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeAdapterFiles)" DestinationFiles="@(FakeAdapterFiles->'$(OutDir)adapters/fake/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
